---
// Card after hazel.ai: a textured panel with a centred badge icon, then kicker, title, and the slotted copy.
import FeatureIcon from './FeatureIcon.astro';
import type { IconName } from './icons';
interface Props { icon: IconName; title: string; kicker?: string; href?: string; external?: boolean; level?: 2 | 3 }
const { icon, title, kicker, href, external = false, level = 3 } = Astro.props;
const Tag = href ? 'a' : 'article';
const Heading = level === 2 ? 'h2' : 'h3';
const linkAttrs = href ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) } : {};
---
<Tag class:list={['fcard', { 'fcard--link': href }]} {...linkAttrs}>
  <div class="fcard__media media-well"><FeatureIcon name={icon} /></div>
  <div class="fcard__body">
    {kicker && <span class="kicker">{kicker}</span>}
    <Heading class="fcard__title">{title}</Heading>
    <slot />
  </div>
</Tag>
