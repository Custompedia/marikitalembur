---
// Badge icon: metallic rim, dark disc, purple glyph. Gradients come from #mkl-icon-defs in Site.astro.
import { glyphs, type IconName } from './icons';
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 104, class: className } = Astro.props;
---
<svg class:list={['ficon', className]} viewBox="0 0 96 96" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="48" cy="48" r="44" fill="url(#mkl-icon-rim)" />
  <circle cx="48" cy="48" r="35" fill="#0b0912" />
  <g fill="none" stroke="url(#mkl-icon-glow)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[name]} />
</svg>
