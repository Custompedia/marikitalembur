---
import '../styles/site.css';
import MklMascot from './MklMascot.astro';
interface Props { page: string }
const { page } = Astro.props;
const titles: Record<string, string> = {
  home: 'MKL — Kerja lebih beres, mulai dari kebutuhanmu',
  'produk-kami': 'Produk MKL untuk pekerjaan nyata',
  'produk/mari-rekap': 'Mari Rekap — bantu susun rekap, tetap kamu yang periksa',
  kelas: 'Kelas dan workshop praktis — MKL',
  'untuk-bisnis': 'Solusi kerja untuk kebutuhan tim — MKL',
  'ajukan-kebutuhan': 'Ceritakan kebutuhanmu — MKL',
  'untuk-partner': 'Untuk builder dan penerbit — MKL',
  tentang: 'Mengenal MKL',
  kontak: 'Hubungi tim MKL',
  'kerja-sama': 'Pilih jalur kerja sama — MKL',
  jelajahi: 'MKL Market — produk dari para penerbit',
  'starter-kit': 'Starter kit di MKL Market',
  'website-saas': 'Produk penerbit di MKL Market',
};
const descriptions: Record<string, string> = {
  home: 'Kenali produk MKL, lihat informasi kelas, atau bahas kebutuhan kerja timmu.',
  'produk-kami': 'Aplikasi buatan MKL untuk membantu pekerjaan yang masih banyak dikerjakan manual.',
  'produk/mari-rekap': 'Mari Rekap membantu menyusun bahan rekap menjadi tabel yang dapat diperiksa, diedit, dan diekspor.',
  kelas: 'Informasi kelas dan workshop praktis dari MKL. Lihat status jadwal dan usulkan topik yang kamu butuhkan.',
  'untuk-bisnis': 'Bahas proses kerja tim, hambatan, dan bentuk bantuan yang sesuai bersama MKL.',
};
// `key` ties a nav item to the home sections that talk about it, so the glass pill can follow the scroll.
const nav = [
  { href: '/produk-kami', label: 'Produk', key: 'produk' },
  { href: '/kelas', label: 'Kelas', key: 'kelas' },
  { href: '/untuk-bisnis', label: 'Untuk Bisnis', key: 'bisnis' },
  { href: '/tentang', label: 'Tentang', key: 'tentang' },
];
const active = page === 'produk/mari-rekap' ? '/produk-kami' : `/${page}`;
const intake = 'https://marikitalembur.com/ajukan-kebutuhan';
const market = 'https://marikitalembur.com/jelajahi';
// The four starting points on the home page; `pose` is the mascot state while that point is in focus.
const paths = [
  { name: 'Produk MKL', navKey: 'produk', href: '/produk-kami', title: 'Gunakan produk yang kami bangun.', desc: 'Jelajahi katalog produk MKL untuk pekerjaan nyata.', action: 'Lihat katalog', img: '/images/mkl-path-produk.webp', external: false, pose: 'working' },
  { name: 'Kelas', navKey: 'kelas', href: '/kelas', title: 'Pelajari cara kerja baru.', desc: 'Informasi kelas dan workshop praktis sesuai jadwal yang tersedia.', action: 'Lihat informasi kelas', img: '/images/mkl-path-kelas.webp', external: false, pose: 'default' },
  { name: 'Untuk Bisnis', navKey: 'bisnis', href: '/untuk-bisnis', title: 'Bahas kebutuhan timmu.', desc: 'Mulai dari proses kerja, lalu tentukan bentuk bantuan yang sesuai.', action: 'Untuk bisnis', img: '/images/mkl-path-bisnis.webp', external: false, pose: 'working' },
  { name: 'Market', navKey: 'market', href: market, title: 'Temukan karya para penerbit.', desc: 'Produk dari penerbit tetap memakai brand mereka. Pilihannya sedang disiapkan.', action: 'Buka Market', img: '/images/mkl-path-market.webp', external: true, pose: 'default' },
];
const ext = (external: boolean) => (external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#010101" />
    <title>{titles[page] ?? 'MKL — Mari Kita Lembur'}</title>
    <meta name="description" content={descriptions[page] ?? 'Produk, pembelajaran, dan bantuan untuk kebutuhan kerja dari MKL.'} />
    <meta property="og:title" content={titles[page] ?? 'MKL — Mari Kita Lembur'} />
    <meta property="og:description" content={descriptions[page] ?? 'Produk, pembelajaran, dan bantuan untuk kebutuhan kerja dari MKL.'} />
    <meta property="og:type" content="website" />
    {page === 'ajukan-kebutuhan' && <meta name="robots" content="noindex,follow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Geist+Mono:wght@400;600&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="MKL, ke beranda"><span class="brand-name">MKL</span></a>
        <nav class="desktop-nav" aria-label="Navigasi utama" data-nav-root>
          <span class="nav-indicator" aria-hidden="true"></span>
          {nav.map((item) => <a href={item.href} data-nav-key={item.key} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}
          <a href={market} target="_blank" rel="noopener noreferrer" data-nav-key="market">Market <span aria-hidden="true">↗</span></a>
        </nav>
        <a class="header-contact" href="/kontak">Hubungi kami <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu"><summary aria-label="Buka navigasi"><span></span><span></span></summary><nav aria-label="Navigasi seluler">{nav.map((item) => <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}<a href={market} target="_blank" rel="noopener noreferrer">Market ↗</a><a href="/kontak" aria-current={page === 'kontak' ? 'page' : undefined}>Hubungi kami</a></nav></details>
      </div>
    </header>
    <main id="konten">
      {page === 'home' && <>
        <section class="hero" aria-label="MKL — Mari Kita Lembur">
          <canvas class="hero__ribbon" data-ribbon aria-hidden="true"></canvas>
          <div class="hero__content container">
            <p class="hero__wordmark t-display">Mari Kita Lembur</p>
            <ul class="hero__labels">
              {paths.map((p, i) => <li><a href={p.href} {...ext(p.external)}><span class="label label--faint">[{pad(i)}]</span><span class="label label--solid">{p.name}</span></a></li>)}
            </ul>
          </div>
        </section>

        <section class="statement container" data-statement>
          <h1 class="statement__heading t-statement">
            <span class="statement__row"><span class="w" data-from="left">Kerja</span>{' '}<span class="w" data-from="right">lebih</span></span>{' '}
            <span class="statement__line"><span class="w" data-from="top">beres,</span>{' '}<span class="w" data-from="bottom">mulai</span></span>{' '}
            <span class="statement__row"><span class="w" data-from="left">dari</span>{' '}<span class="w" data-from="right">kebutuhanmu.</span></span>
          </h1>
          <div class="statement__aside">
            <p class="label">Kenali produk MKL, lihat informasi kelas, atau bahas kebutuhan kerja timmu.</p>
            <a class="cta" href="#jelajahi">Jelajahi MKL</a>
          </div>
        </section>

        <section class="about-pin" id="jelajahi" data-about data-nav="" aria-labelledby="jelajahi-title">
          <div class="about-pin__inner container">
            <h2 id="jelajahi-title" class="sr-only">Pilih titik awal: mau membereskan apa?</h2>
            <div class="about-pin__top">
              <ol class="about-pin__index">
                {paths.map((p, i) => <li class="about-pin__item" data-about-item><a href={p.href} {...ext(p.external)}><span class="label label--lg label--faint">[{pad(i)}]</span><span class="label label--lg">{p.name}</span></a></li>)}
              </ol>
              <div class="about-pin__panes">
                <div class="about-pin__pane is-active" data-about-pane data-pose="default" data-nav-key="">
                  <p class="label">Empat jalur untuk kebutuhan yang berbeda. Pilih yang paling dekat dengan pekerjaanmu sekarang.</p>
                  <span class="label">/04</span>
                  <span class="label">Pilih titik awal</span>
                </div>
                {paths.map((p, i) => <div class="about-pin__pane about-pin__pane--path" data-about-pane data-pose={p.pose} data-nav-key={p.navKey}>
                  <p class="label">{p.desc}</p>
                  <span class="label">/{pad(i)}</span>
                  <a class="label" href={p.href} {...ext(p.external)}>{p.action} ↗</a>
                </div>)}
              </div>
            </div>
            <div class="about-pin__stage">
              <canvas class="about-pin__dust" data-pixel-dust aria-hidden="true"></canvas>
              <MklMascot class="about-pin__mascot" size={440} seed={0.3} jumpEvery={10} />
            </div>
          </div>
        </section>

        <section class="about-outro container" data-nav="bisnis" aria-labelledby="memulai-title">
          <p class="label">Cara kami memulai</p>
          <div class="about-outro__copy">
            <h2 id="memulai-title" class="t-title" data-reveal>Mulai dari cara kerja timmu. Ada pekerjaan yang tidak selesai dengan satu aplikasi?</h2>
            <p class="about-outro__body">Ceritakan proses yang ingin diperbaiki. Kebutuhan itu menjadi dasar pembahasan pelatihan atau solusi yang sesuai.</p>
            <a class="cta" href="/untuk-bisnis">Jelajahi bantuan untuk bisnis</a>
          </div>
        </section>

        <section class="services container" aria-labelledby="jalur-title">
          <h2 id="jalur-title" class="sr-only">Empat jalur MKL</h2>
          {paths.map((p, i) => <article class="svc-row" style={`--i:${i}`} data-nav={p.navKey}>
            <div class="svc-row__index"><span class="label label--lg label--faint">[{pad(i)}]</span></div>
            <div class="svc-row__body">
              <div class="svc-row__text"><h3 class="t-title">{p.title}</h3><p class="label">{p.desc}</p></div>
              <a class="cta" href={p.href} {...ext(p.external)}>{p.action}</a>
            </div>
            <div class="svc-row__media"><img src={p.img} width="1536" height="1024" alt="" loading="lazy" /></div>
          </article>)}
        </section>

        <section class="contact container" data-nav="tentang" aria-labelledby="penutup-title">
          <p class="label">Jelas sejak awal</p>
          <h2 id="penutup-title" class="contact__heading" data-reveal>Tahu siapa pembuatnya. <em>Jelas langkah berikutnya.</em></h2>
          <p class="contact__body">Produk MKL kami bangun sendiri. Produk di Market tetap memakai brand penerbitnya. Informasi kelas mengikuti jadwal yang benar-benar dibuka.</p>
          <div class="actions"><a class="cta" href="/tentang">Tentang MKL</a><a class="cta cta--muted" href="/untuk-partner">Untuk builder dan penerbit</a></div>
        </section>
      </>}
      {page === 'produk-kami' && <><section class="page-hero container"><p class="eyebrow">PRODUK / DIBUAT OLEH MKL</p><h1>Produk MKL untuk <em>pekerjaan nyata.</em></h1><p class="lead">Aplikasi yang kami bangun untuk membantu pekerjaan yang masih banyak dikerjakan manual.</p></section><section class="section container"><div class="catalog-product"><a class="product-card" href="/produk/mari-rekap"><img src="/images/mkl-produk-rekap-workspace.webp" width="1536" height="1024" alt="" loading="lazy" /><span class="product-card-kicker">01 / PRODUK DARI MKL</span><div class="product-card-content"><h2>Mari Rekap</h2><p>Dari bahan rekap ke tabel yang bisa diperiksa.</p><span class="product-card-action">Kenali Mari Rekap <span aria-hidden="true">↗</span></span></div></a><div class="product-card-meta"><p>Susun data, periksa hasilnya, lalu ekspor untuk pekerjaan berikutnya.</p><dl><div><dt>INPUT</dt><dd>Foto · PDF · Teks</dd></div><div><dt>PROSES</dt><dd>Susun · Periksa · Koreksi</dd></div><div><dt>HASIL</dt><dd>Ekspor Excel</dd></div></dl></div></div></section><section class="section container split-note"><h2>Kebutuhan timmu <em>lebih khusus?</em></h2><div><p>Mulai dengan menceritakan proses yang ingin kamu perbaiki. Bantuan untuk tim dibahas sesuai kebutuhan, terpisah dari penggunaan produk.</p><a class="text-link" href="/untuk-bisnis">Bahas kebutuhan tim <span>↗</span></a></div></section></>}
      {page === 'produk/mari-rekap' && <><section class="page-hero container"><a class="breadcrumb" href="/produk-kami">← Produk MKL</a><p class="eyebrow">MARI REKAP / PRODUK DARI MKL</p><h1>Mari Rekap — bantu susun rekap, <em>tetap kamu yang periksa.</em></h1><p class="lead">Membantu mengolah bahan rekap menjadi tabel yang dapat diperiksa dan diedit sebelum digunakan.</p><div class="actions"><a class="button button-light" href="#cara-kerja">Lihat cara kerjanya <span>↓</span></a><a class="text-link" href="/kontak">Tanya tentang Mari Rekap <span>↗</span></a></div></section><section class="section container split-note"><div><p class="eyebrow">01 / UNTUK SIAPA</p><h2>Untuk pekerjaan yang masih banyak <em>rekap manual.</em></h2></div><p>Mulai dari bahan seperti struk, invoice, foto, PDF, atau teks. Cocok saat kamu perlu menyusun catatan menjadi tabel yang mudah ditinjau. Hasil tetap perlu pemeriksaan manusia.</p></section><section class="section container" id="cara-kerja"><div class="section-heading"><p class="eyebrow">02 / ALUR KERJA</p><h2>Masukkan bahan. Periksa hasil. <em>Ekspor rekap.</em></h2></div><div class="step-grid"><article><span>01</span><h3>Masukkan bahan</h3><p>Siapkan foto, PDF, atau teks yang memuat data untuk direkap.</p></article><article><span>02</span><h3>Tinjau draf</h3><p>Mari Rekap membantu menyusun draf tabel. Periksa dan koreksi isinya.</p></article><article><span>03</span><h3>Ekspor hasil</h3><p>Setelah siap, ekspor rekap untuk pekerjaan berikutnya dalam format Excel.</p></article></div></section><section class="section container two-column"><div><p class="eyebrow">03 / KEMAMPUAN SAAT INI</p><h2>Yang bisa dikerjakan <em>sekarang.</em></h2></div><div class="line-list"><div><span>01</span><p>Gunakan bahan dari foto, PDF, atau teks.</p></div><div><span>02</span><p>Tinjau dan koreksi draf rekap.</p></div><div><span>03</span><p>Ekspor hasil ke file Excel.</p></div></div></section><section class="section container split-note"><div><p class="eyebrow">04 / KENDALI TETAP PADAMU</p><h2>Hasil tetap perlu <em>diperiksa.</em></h2></div><p>Kelengkapan dan keterbacaan bahan memengaruhi hasil. Periksa kembali angka, keterangan, dan susunan data sebelum digunakan untuk keputusan atau pelaporan.</p></section><section class="section container access-panel"><div><p class="eyebrow">05 / PAKET & AKSES</p><h2>Paket dan akses <em>Mari Rekap.</em></h2><p>Informasi penawaran tersedia pada halaman produk MKL yang aktif. Pembayaran publik belum tersedia; harga yang tampil tidak berarti checkout sudah dibuka.</p></div><div class="access-action"><span>INGIN TAHU AKSES YANG TERSEDIA?</span><a class="button button-light" href="/kontak">Tanya tentang akses <span>↗</span></a><a class="text-link" href="https://rekap.marikitalembur.com" target="_blank" rel="noopener noreferrer">Sudah punya akses? Buka aplikasi <span>↗</span></a></div></section><section class="section container faq"><p class="eyebrow">06 / PERTANYAAN PENTING</p><h2>Sebelum menggunakan <em>Mari Rekap.</em></h2><details><summary>Bahan apa yang bisa digunakan?<span>+</span></summary><p>Baseline produk mencakup foto, PDF, dan teks. Hasil tiap bahan bergantung pada keterbacaan dan kelengkapan informasinya.</p></details><details><summary>Apakah hasilnya bisa langsung dipakai?<span>+</span></summary><p>Periksa dan koreksi draf terlebih dahulu, terutama angka dan keterangan penting.</p></details><details><summary>Bisakah hasilnya diekspor?<span>+</span></summary><p>Rekap yang sudah diperiksa dapat diekspor ke format Excel.</p></details><details><summary>Apakah pembayaran sudah dibuka?<span>+</span></summary><p>Pembayaran publik belum tersedia. Hubungi MKL untuk menanyakan status akses yang sesuai.</p></details><a class="text-link" href="/kontak">Hubungi tim MKL <span>↗</span></a></section></>}
      {page === 'kelas' && <><section class="page-hero container class-hero"><p class="eyebrow">KELAS / BELAJAR PRAKTIS</p><h1>Belajar untuk pekerjaan <em>yang kamu hadapi.</em></h1><p class="lead">Informasi kelas dan workshop tentang AI, tools, dan cara kerja yang bisa dipraktikkan.</p></section><section class="section container class-availability" aria-labelledby="class-status-title"><div class="class-availability-head"><p class="eyebrow">STATUS KELAS</p><span>INFORMASI TERKINI / 01</span></div><div class="class-availability-body"><h2 id="class-status-title">Belum ada jadwal kelas yang dibuka.</h2><div><p>Punya topik yang ingin kamu pelajari? Ceritakan kebutuhanmu melalui formulir MKL.</p><a class="button button-light" href="/ajukan-kebutuhan">Usulkan topik kelas <span aria-hidden="true">↗</span></a></div></div></section></>}
      {page === 'untuk-bisnis' && <><section class="page-hero container"><p class="eyebrow">UNTUK BISNIS / MULAI DARI PROSES</p><h1>Solusi kerja yang berangkat dari <em>kebutuhan tim.</em></h1><p class="lead">Mulai dari proses yang ingin diperbaiki. Kita bahas kebutuhan, hambatan, dan bentuk bantuan yang sesuai.</p><div class="actions"><a class="button button-light" href="/ajukan-kebutuhan">Bahas kebutuhan tim <span>↗</span></a><a class="text-link" href="#bentuk-bantuan">Lihat bentuk bantuan <span>↓</span></a></div></section><section class="section container split-note"><div><p class="eyebrow">01 / MASALAHNYA</p><h2>Saat pekerjaan berulang mulai <em>menghambat tim.</em></h2></div><div><p>Data disalin dari banyak tempat, hasil kerja diperiksa berulang, atau tools baru belum menyatu dengan proses yang ada.</p><div class="mini-tags"><span>Pemindahan data manual</span><span>Pemeriksaan berulang</span><span>Alur tools belum jelas</span></div></div></section><section class="section container split-note"><div><p class="eyebrow">02 / SIAPA YANG COCOK</p><h2>Untuk tim yang ingin memperbaiki <em>cara kerjanya.</em></h2></div><p>Cocok untuk pemilik bisnis dan pemimpin tim yang punya proses nyata untuk dipelajari bersama, baik pada pekerjaan operasional, administrasi, kreatif, maupun manajemen.</p></section><section class="section container" id="bentuk-bantuan"><div class="section-heading"><p class="eyebrow">03 / BENTUK BANTUAN</p><h2>Pilih bantuan sesuai <em>tahap timmu.</em></h2><p>Belum tahu harus mulai dari mana? Jelaskan kebutuhannya dulu. Bentuk bantuan ditentukan dari tujuan dan kondisi tim.</p></div><div class="service-list"><article><span>01 / PAHAMI</span><h3>Petakan pekerjaan yang perlu diperbaiki.</h3><p>Tinjau alur, hambatan, dan peluang sebelum memilih penggunaan AI atau otomatisasi.</p></article><article><span>02 / PELAJARI</span><h3>Belajar dari pekerjaan tim sendiri.</h3><p>Materi dan latihan dapat disusun berdasarkan peran, tools, dan kebutuhan yang disepakati.</p></article><article><span>03 / UJI</span><h3>Coba satu alur kerja yang jelas.</h3><p>Fokus pada satu kebutuhan agar solusi dapat dicoba, ditinjau, dan diperbaiki.</p></article><article><span>04 / TERAPKAN</span><h3>Bawa solusi ke proses tim.</h3><p>Penerapan mengikuti ruang lingkup, pengujian, dan penanggung jawab yang disepakati.</p></article><article><span>05 / TINJAU</span><h3>Perbaiki langkah berikutnya.</h3><p>Pendampingan berkala dapat dibahas ketika tim membutuhkan evaluasi lanjutan.</p></article></div><p class="service-caveat">Bentuk dan ketersediaan bantuan dibahas berdasarkan kebutuhan serta kesiapan ruang lingkup.</p></section><section class="section container"><div class="section-heading"><p class="eyebrow">04 / CARA KERJA</p><h2>Pahami prosesnya, <em>sepakati langkahnya.</em></h2></div><div class="step-grid"><article><span>01</span><h3>Ceritakan kebutuhan</h3><p>Jelaskan proses, kendala, dan hasil yang ingin dicapai.</p></article><article><span>02</span><h3>Tinjau alur kerja</h3><p>Bahas konteks dan batas pekerjaan sebelum menentukan pendekatan.</p></article><article><span>03</span><h3>Sepakati ruang lingkup</h3><p>Pelatihan atau penerapan dilakukan sesuai kesepakatan yang jelas.</p></article></div></section><section class="section container split-note"><div><p class="eyebrow">05 / KELUARAN</p><h2>Hasil kerja yang bisa <em>dipakai tim.</em></h2></div><p>Keluaran mengikuti ruang lingkup. Bisa berupa peta proses, materi praktik, dokumentasi, atau solusi yang diuji pada pekerjaan nyata.</p></section><section class="section container split-note"><div><p class="eyebrow">06 / KESIAPAN</p><h2>Ada proses yang jelas, ada orang yang bisa <em>diajak bekerja.</em></h2></div><p>Pembahasan lebih berguna ketika tim dapat menjelaskan proses saat ini, kendala, dan hasil yang diharapkan. Jangan kirim data rahasia melalui formulir awal.</p></section><section class="section container split-note"><div><p class="eyebrow">07 / PRINSIP KERJA</p><h2>Mulai dari kebutuhan, tetap <em>periksa hasilnya.</em></h2></div><p>AI dipertimbangkan ketika sesuai dengan pekerjaan. Batas, pemeriksaan manusia, dan tanggung jawab operasional perlu disepakati.</p></section><section class="section container cta-panel"><p class="eyebrow">08 / LANGKAH PERTAMA</p><h2>Ceritakan proses yang ingin <em>kamu perbaiki.</em></h2><p>Kirim gambaran kebutuhan dan hasil yang diharapkan agar tim MKL dapat meninjau langkah berikutnya.</p><div class="actions"><a class="button button-light" href="/ajukan-kebutuhan">Bahas kebutuhan tim <span>↗</span></a><a class="text-link" href="/kontak">Punya pertanyaan dulu? <span>↗</span></a></div></section></>}
