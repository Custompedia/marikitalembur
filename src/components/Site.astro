---
import '../styles/site.css';
import MklMascot from './MklMascot.astro';
import PageHero from './PageHero.astro';
import FeatureCard from './FeatureCard.astro';
import Banner from './Banner.astro';
import ProductCard from './ProductCard.astro';
import type { IconName } from './icons';
interface Props { page: string }
const { page } = Astro.props;
const titles: Record<string, string> = {
  home: 'MKL - Kerja lebih beres, mulai dari kebutuhanmu',
  'produk-kami': 'Produk MKL untuk pekerjaan nyata',
  'produk/mari-rekap': 'Mari Rekap - bantu susun rekap, tetap kamu yang periksa',
  kelas: 'Kelas dan workshop praktis - MKL',
  'untuk-bisnis': 'Solusi kerja untuk kebutuhan tim - MKL',
  'ajukan-kebutuhan': 'Ceritakan kebutuhanmu - MKL',
  tentang: 'Mengenal MKL',
  kontak: 'Hubungi tim MKL',
  'kerja-sama': 'Pilih jalur kerja sama - MKL',
};
const descriptions: Record<string, string> = {
  home: 'Kenali produk MKL, lihat informasi kelas, atau bahas kebutuhan kerja timmu.',
  'produk-kami': 'Aplikasi buatan MKL untuk membantu pekerjaan yang masih banyak dikerjakan manual.',
  'produk/mari-rekap': 'Mari Rekap membantu menyusun bahan rekap menjadi tabel yang dapat diperiksa, diedit, dan diekspor.',
  kelas: 'Informasi kelas dan workshop praktis dari MKL. Lihat status jadwal dan usulkan topik yang kamu butuhkan.',
  'untuk-bisnis': 'Bahas proses kerja tim, hambatan, dan bentuk bantuan yang sesuai bersama MKL.',
};
// `key` ties a nav item to the home sections that talk about it, so the nav pill can follow the scroll.
const nav = [
  { href: '/produk-kami', label: 'Produk', key: 'produk' },
  { href: '/kelas', label: 'Kelas', key: 'kelas' },
  { href: '/untuk-bisnis', label: 'Untuk Bisnis', key: 'bisnis' },
  { href: '/tentang', label: 'Tentang', key: 'tentang' },
];
const active = page === 'produk/mari-rekap' ? '/produk-kami' : `/${page}`;
const intake = 'https://marikitalembur.com/ajukan-kebutuhan';
// The three starting points on the home page; `pose` is the mascot state while that point is in focus.
const paths = [
  { name: 'Produk MKL', navKey: 'produk', href: '/produk-kami', title: 'Gunakan produk yang kami bangun.', desc: 'Jelajahi katalog produk MKL untuk pekerjaan nyata.', action: 'Lihat katalog', img: '/images/mkl-path-produk.webp', tags: ['Foto', 'PDF', 'Teks'], pose: 'working' },
  { name: 'Kelas', navKey: 'kelas', href: '/kelas', title: 'Pelajari cara kerja baru.', desc: 'Informasi kelas dan workshop praktis sesuai jadwal yang tersedia.', action: 'Lihat informasi kelas', img: '/images/mkl-path-kelas.webp', tags: ['AI', 'Tools', 'Cara kerja'], pose: 'default' },
  { name: 'Untuk Bisnis', navKey: 'bisnis', href: '/untuk-bisnis', title: 'Bahas kebutuhan timmu.', desc: 'Mulai dari proses kerja, lalu tentukan bentuk bantuan yang sesuai.', action: 'Untuk bisnis', img: '/images/mkl-path-bisnis.webp', tags: ['Pahami', 'Uji', 'Terapkan'], pose: 'working' },
];
const pad = (i: number) => String(i + 1).padStart(2, '0');
const services: { icon: IconName; kicker: string; title: string; text: string }[] = [
  { icon: 'map', kicker: '01 / Pahami', title: 'Petakan pekerjaan yang perlu diperbaiki.', text: 'Tinjau alur, hambatan, dan peluang sebelum memilih penggunaan AI atau otomatisasi.' },
  { icon: 'learn', kicker: '02 / Pelajari', title: 'Belajar dari pekerjaan tim sendiri.', text: 'Materi dan latihan dapat disusun berdasarkan peran, tools, dan kebutuhan yang disepakati.' },
  { icon: 'test', kicker: '03 / Uji', title: 'Coba satu alur kerja yang jelas.', text: 'Fokus pada satu kebutuhan agar solusi dapat dicoba, ditinjau, dan diperbaiki.' },
  { icon: 'apply', kicker: '04 / Terapkan', title: 'Bawa solusi ke proses tim.', text: 'Penerapan mengikuti ruang lingkup, pengujian, dan penanggung jawab yang disepakati.' },
  { icon: 'repeat', kicker: '05 / Tinjau', title: 'Perbaiki langkah berikutnya.', text: 'Pendampingan berkala dapat dibahas ketika tim membutuhkan evaluasi lanjutan.' },
];
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#010101" />
    <title>{titles[page] ?? 'MKL - Mari Kita Lembur'}</title>
    <meta name="description" content={descriptions[page] ?? 'Produk, pembelajaran, dan bantuan untuk kebutuhan kerja dari MKL.'} />
    <meta property="og:title" content={titles[page] ?? 'MKL - Mari Kita Lembur'} />
    <meta property="og:description" content={descriptions[page] ?? 'Produk, pembelajaran, dan bantuan untuk kebutuhan kerja dari MKL.'} />
    <meta property="og:type" content="website" />
    {page === 'ajukan-kebutuhan' && <meta name="robots" content="noindex,follow" />}
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..700&family=Geist:wght@300..700&family=Fragment+Mono:ital@0;1&family=Manrope:wght@800&display=swap" rel="stylesheet" />
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#konten">Lewati ke konten</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="MKL, ke beranda"><span class="brand-name">MKL</span></a>
        <nav class="desktop-nav" aria-label="Navigasi utama" data-nav-root>
          <span class="nav-indicator" aria-hidden="true"></span>
          {nav.map((item) => <a href={item.href} data-nav-key={item.key} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-contact" href="/kontak">Hubungi kami <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu"><summary aria-label="Buka navigasi"><span></span><span></span></summary><nav aria-label="Navigasi seluler">{nav.map((item) => <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>{item.label}</a>)}<a href="/kontak" aria-current={page === 'kontak' ? 'page' : undefined}>Hubungi kami</a></nav></details>
      </div>
    </header>
    <main id="konten">
      {page === 'home' && <>
        <section class="hero" data-hero aria-label="MKL - Mari Kita Lembur">
          <div class="hero__pin">
            <canvas class="hero__sphere" data-hero-sphere aria-hidden="true"></canvas>
            <div class="hero__stage container">
              <svg class="hero__orbit" viewBox="0 0 100 100" aria-hidden="true">
                <circle class="hero__orbit-ring" cx="50" cy="50" r="49.5" pathLength="100" />
                <circle class="hero__orbit-dot" cx="81.4" cy="11.8" r="0.55" /><circle class="hero__orbit-dot" cx="10.6" cy="80.2" r="0.55" />
              </svg>

              <div class="hero__brand hero__fade" aria-hidden="true">
                <span class="hero__sub" data-scramble>MKL</span>
                <span class="hero__plus hero__plus--a"></span><span class="hero__plus hero__plus--b"></span>
              </div>

              <div class="hero__top hero__fade">
                <p class="hero__sub"><span data-scramble>Produk, kelas &amp; solusi kerja</span><br /><span data-scramble>untuk kebutuhan timmu</span></p>
                <p class="hero__word" aria-hidden="true" data-hero-word data-words="bereskan,susun,pelajari">bereskan</p>
                <a class="hero__btn" href="/produk-kami" aria-label="Lihat produk MKL"><span data-scramble>Lihat produk MKL</span></a>
              </div>

              <div class="hero__axis" aria-hidden="true">
                <span class="hero__axis-dot hero__axis-dot--l"></span><span class="hero__axis-dot hero__axis-dot--r"></span>
                <span class="hero__readout hero__readout--l" data-hero-readout="pitch">-12.0000°</span>
                <span class="hero__readout hero__readout--r" data-hero-readout="yaw">124.0000°</span>
              </div>

              <div class="hero__reel" data-hero-reel aria-hidden="true">
                <canvas class="hero__ribbon" data-ribbon></canvas>
              </div>
              {['tl', 'tr', 'bl', 'br'].map((c) => <span class="hero__corner" data-hero-corner={c} aria-hidden="true"></span>)}
              <span class="hero__reel-label hero__reel-label--l" data-hero-label="l" aria-hidden="true"><span data-scramble>Lihat jalur</span></span>
              <a class="hero__play" href="#jelajahi" aria-label="Lihat tiga jalur MKL">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v10M3.5 8.5 8 13l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
              <span class="hero__reel-label hero__reel-label--r" data-hero-label="r" aria-hidden="true"><span data-scramble>03 jalur</span></span>

              <p class="hero__title hero__fade"><span class="hero__title-sm">Mari kita</span><span class="hero__title-lg">lembur.</span></p>
              <a class="hero__next hero__fade" href="#pernyataan" aria-label="Gulir ke bagian berikutnya"><span></span><span></span><span></span></a>
            </div>
          </div>
        </section>

        <section class="statement container" id="pernyataan" data-statement>
          <div class="dot-rule" aria-hidden="true"></div>
          <h1 class="statement__heading t-statement">
            <span class="statement__row"><span class="w" data-from="left">Kerja</span>{' '}<span class="w" data-from="right">lebih</span></span>{' '}
            <span class="statement__line"><span class="w" data-from="top">beres,</span>{' '}<span class="w" data-from="bottom">mulai</span></span>{' '}
            <span class="statement__row"><span class="w" data-from="left">dari</span>{' '}<span class="w" data-from="right">kebutuhanmu.</span></span>
          </h1>
          <div class="statement__aside">
            <p class="label">Kenali produk MKL, lihat informasi kelas, atau bahas kebutuhan kerja timmu.</p>
            <a class="cta" href="#jelajahi">Jelajahi MKL</a>
          </div>
        </section>

        <section class="about-pin" id="jelajahi" data-about data-nav="" aria-labelledby="jelajahi-title">
          <div class="about-pin__inner container">
            <h2 id="jelajahi-title" class="sr-only">Pilih titik awal: mau membereskan apa?</h2>
            <div class="about-pin__top">
              <ol class="about-pin__index">
                {paths.map((p, i) => <li class="about-pin__item" data-about-item><a href={p.href}><span class="label label--lg label--faint">[{pad(i)}]</span><span class="label label--lg">{p.name}</span></a></li>)}
              </ol>
              <div class="about-pin__panes">
                <div class="about-pin__pane is-active" data-about-pane data-pose="default" data-nav-key="">
                  <p class="label">Tiga jalur untuk kebutuhan yang berbeda. Pilih yang paling dekat dengan pekerjaanmu sekarang.</p>
                  <span class="label">/{String(paths.length).padStart(2, '0')}</span>
                  <span class="label">Pilih titik awal</span>
                </div>
                {paths.map((p, i) => <div class="about-pin__pane about-pin__pane--path" data-about-pane data-pose={p.pose} data-nav-key={p.navKey}>
                  <p class="label">{p.desc}</p>
                  <span class="label">/{pad(i)}</span>
                  <a class="label" href={p.href}>{p.action} ↗</a>
                </div>)}
              </div>
            </div>
            <div class="about-pin__stage">
              <canvas class="about-pin__dust" data-pixel-dust aria-hidden="true"></canvas>
              <MklMascot class="about-pin__mascot" size={440} seed={0.3} jumpEvery={10} />
            </div>
          </div>
        </section>

        <section class="about-outro container" data-nav="bisnis" aria-labelledby="memulai-title">
          <p class="label">Cara kami memulai</p>
          <div class="about-outro__copy">
            <h2 id="memulai-title" class="t-title" data-reveal>Mulai dari cara kerja timmu. Ada pekerjaan yang tidak selesai dengan satu aplikasi?</h2>
            <p class="about-outro__body">Ceritakan proses yang ingin diperbaiki. Kebutuhan itu menjadi dasar pembahasan pelatihan atau solusi yang sesuai.</p>
            <a class="cta" href="/untuk-bisnis">Jelajahi bantuan untuk bisnis</a>
          </div>
        </section>

        <section class="services container" aria-labelledby="jalur-title">
          <h2 id="jalur-title" class="sr-only">Tiga jalur MKL</h2>
          <div class="pcard-grid">
            {paths.map((p, i) => <ProductCard href={p.href} image={p.img} label={p.name} title={p.title} desc={p.desc} action={p.action} foot={`MKL / ${pad(i)}`} tags={p.tags} tint={i} />)}
          </div>
        </section>

        <section class="closing container" data-nav="tentang" aria-labelledby="penutup-title">
          <div class="closing__card">
            <Banner size="fill" variant={1} />
            <p class="closing__eyebrow">Jelas sejak awal</p>
            <h2 id="penutup-title" class="closing__heading" data-reveal>Tahu siapa pembuatnya. <em>Jelas langkah berikutnya.</em></h2>
            <p class="closing__body">Produk MKL kami bangun sendiri. Informasi kelas mengikuti jadwal yang benar-benar dibuka.</p>
            <div class="closing__actions"><a class="button" href="/tentang">Tentang MKL <span aria-hidden="true">↗</span></a><a class="text-link" href="/kontak">Hubungi kami <span aria-hidden="true">↗</span></a></div>
          </div>
        </section>
      </>}
      {page === 'produk-kami' && <>
        <PageHero eyebrow="Produk / Dibuat oleh MKL" image="/images/mkl-path-produk.webp">
          <Fragment slot="title">Produk MKL untuk <em>pekerjaan nyata.</em></Fragment>
          <Fragment slot="lead">Aplikasi yang kami bangun untuk membantu pekerjaan yang masih banyak dikerjakan manual.</Fragment>
        </PageHero>
        <section class="section container">
          <div class="product-stage">
            <Banner size="fill" variant={0} />
            <ProductCard glass level={2} href="/produk/mari-rekap" image="/images/mkl-produk-rekap-workspace.webp" label="Produk dari MKL" title="Mari Rekap" desc="Dari bahan rekap ke tabel yang bisa diperiksa." action="Kenali Mari Rekap" foot="MKL / 01" tags={['Foto · PDF · Teks', 'Ekspor Excel']}>
              <p class="pcard__desc">Susun data, periksa hasilnya, lalu ekspor untuk pekerjaan berikutnya.</p>
            </ProductCard>
          </div>
        </section>
        <section class="section container">
          <div class="cta-panel cta-panel--split">
            <h2>Kebutuhan timmu <em>lebih khusus?</em></h2>
            <div>
              <p>Mulai dengan menceritakan proses yang ingin kamu perbaiki. Bantuan untuk tim dibahas sesuai kebutuhan, terpisah dari penggunaan produk.</p>
              <div class="actions"><a class="button" href="/untuk-bisnis">Bahas kebutuhan tim <span aria-hidden="true">↗</span></a></div>
            </div>
          </div>
        </section>
      </>}
      {page === 'produk/mari-rekap' && <>
        <PageHero eyebrow="Mari Rekap / Produk dari MKL" image="/images/mkl-produk-rekap-workspace.webp" crumb={{ href: '/produk-kami', label: '← Produk MKL' }}>
          <Fragment slot="title">Mari Rekap - bantu susun rekap, <em>tetap kamu yang periksa.</em></Fragment>
          <Fragment slot="lead">Membantu mengolah bahan rekap menjadi tabel yang dapat diperiksa dan diedit sebelum digunakan.</Fragment>
          <Fragment slot="actions"><a class="button" href="#cara-kerja">Lihat cara kerjanya <span aria-hidden="true">↓</span></a><a class="text-link" href="/kontak">Tanya tentang Mari Rekap <span aria-hidden="true">↗</span></a></Fragment>
        </PageHero>
        <section class="section container">
          <div class="panel split-note">
            <div><p class="eyebrow">01 / Untuk siapa</p><h2>Untuk pekerjaan yang masih banyak <em>rekap manual.</em></h2></div>
            <p>Mulai dari bahan seperti struk, invoice, foto, PDF, atau teks. Cocok saat kamu perlu menyusun catatan menjadi tabel yang mudah ditinjau. Hasil tetap perlu pemeriksaan manusia.</p>
          </div>
        </section>
        <section class="section container" id="cara-kerja">
          <div class="section-heading"><p class="eyebrow">02 / Alur kerja</p><h2>Masukkan bahan. Periksa hasil. <em>Ekspor rekap.</em></h2></div>
          <div class="card-grid">
            <FeatureCard variant={0} icon="input" kicker="01" title="Masukkan bahan"><p>Siapkan foto, PDF, atau teks yang memuat data untuk direkap.</p></FeatureCard>
            <FeatureCard variant={1} icon="review" kicker="02" title="Tinjau draf"><p>Mari Rekap membantu menyusun draf tabel. Periksa dan koreksi isinya.</p></FeatureCard>
            <FeatureCard variant={2} icon="export" kicker="03" title="Ekspor hasil"><p>Setelah siap, ekspor rekap untuk pekerjaan berikutnya dalam format Excel.</p></FeatureCard>
          </div>
        </section>
        <section class="section container">
          <div class="panel panel--rows">
            <div class="split-note">
              <div><p class="eyebrow">03 / Kemampuan saat ini</p><h2>Yang bisa dikerjakan <em>sekarang.</em></h2></div>
              <ol class="num-list"><li>Gunakan bahan dari foto, PDF, atau teks.</li><li>Tinjau dan koreksi draf rekap.</li><li>Ekspor hasil ke file Excel.</li></ol>
            </div>
            <div class="split-note">
            <div><p class="eyebrow">04 / Kendali tetap padamu</p><h2>Hasil tetap perlu <em>diperiksa.</em></h2></div>
            <p>Kelengkapan dan keterbacaan bahan memengaruhi hasil. Periksa kembali angka, keterangan, dan susunan data sebelum digunakan untuk keputusan atau pelaporan.</p>
            </div>
          </div>
        </section>
        <section class="section container">
          <div class="panel split-note">
            <div><p class="eyebrow">05 / Paket &amp; akses</p><h2>Paket dan akses <em>Mari Rekap.</em></h2><p>Informasi penawaran tersedia pada halaman produk MKL yang aktif. Pembayaran publik belum tersedia; harga yang tampil tidak berarti checkout sudah dibuka.</p></div>
            <div class="access-action">
              <span class="kicker">Ingin tahu akses yang tersedia?</span>
              <a class="button" href="/kontak">Tanya tentang akses <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="https://rekap.marikitalembur.com" target="_blank" rel="noopener noreferrer">Sudah punya akses? Buka aplikasi <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>
        <section class="section container faq">
          <div class="section-heading"><p class="eyebrow">06 / Pertanyaan penting</p><h2>Sebelum menggunakan <em>Mari Rekap.</em></h2></div>
          <div class="faq__list">
            <details><summary>Bahan apa yang bisa digunakan?<span aria-hidden="true">+</span></summary><p>Baseline produk mencakup foto, PDF, dan teks. Hasil tiap bahan bergantung pada keterbacaan dan kelengkapan informasinya.</p></details>
            <details><summary>Apakah hasilnya bisa langsung dipakai?<span aria-hidden="true">+</span></summary><p>Periksa dan koreksi draf terlebih dahulu, terutama angka dan keterangan penting.</p></details>
            <details><summary>Bisakah hasilnya diekspor?<span aria-hidden="true">+</span></summary><p>Rekap yang sudah diperiksa dapat diekspor ke format Excel.</p></details>
            <details><summary>Apakah pembayaran sudah dibuka?<span aria-hidden="true">+</span></summary><p>Pembayaran publik belum tersedia. Hubungi MKL untuk menanyakan status akses yang sesuai.</p></details>
          </div>
          <p class="section-more"><a class="text-link" href="/kontak">Hubungi tim MKL <span aria-hidden="true">↗</span></a></p>
        </section>
      </>}
      {page === 'kelas' && <>
        <PageHero eyebrow="Kelas / Belajar praktis" image="/images/mkl-path-kelas.webp">
          <Fragment slot="title">Belajar untuk pekerjaan <em>yang kamu hadapi.</em></Fragment>
          <Fragment slot="lead">Informasi kelas dan workshop tentang AI, tools, dan cara kerja yang bisa dipraktikkan.</Fragment>
        </PageHero>
        <section class="section container" aria-labelledby="class-status-title">
          <div class="status-card">
            <Banner icon="calendar" size="tall" variant={1} class="status-card__media" />
            <div class="status-card__body">
              <div class="status-card__head"><span class="status-pill"><span></span>Status kelas</span><span class="kicker">Informasi terkini / 01</span></div>
              <h2 id="class-status-title">Belum ada jadwal kelas yang dibuka.</h2>
              <p>Punya topik yang ingin kamu pelajari? Ceritakan kebutuhanmu melalui formulir MKL.</p>
              <a class="button" href="/ajukan-kebutuhan">Usulkan topik kelas <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>
      </>}
      {page === 'untuk-bisnis' && <>
        <PageHero eyebrow="Untuk bisnis / Mulai dari proses" image="/images/mkl-path-bisnis.webp">
          <Fragment slot="title">Solusi kerja yang berangkat dari <em>kebutuhan tim.</em></Fragment>
          <Fragment slot="lead">Mulai dari proses yang ingin diperbaiki. Kita bahas kebutuhan, hambatan, dan bentuk bantuan yang sesuai.</Fragment>
          <Fragment slot="actions"><a class="button" href="/ajukan-kebutuhan">Bahas kebutuhan tim <span aria-hidden="true">↗</span></a><a class="text-link" href="#bentuk-bantuan">Lihat bentuk bantuan <span aria-hidden="true">↓</span></a></Fragment>
        </PageHero>
        <section class="section container">
          <div class="panel panel--rows">
            <div class="split-note">
            <div><p class="eyebrow">01 / Masalahnya</p><h2>Saat pekerjaan berulang mulai <em>menghambat tim.</em></h2></div>
            <div>
              <p>Data disalin dari banyak tempat, hasil kerja diperiksa berulang, atau tools baru belum menyatu dengan proses yang ada.</p>
              <div class="mini-tags"><span>Pemindahan data manual</span><span>Pemeriksaan berulang</span><span>Alur tools belum jelas</span></div>
            </div>
            </div>
            <div class="split-note">
            <div><p class="eyebrow">02 / Siapa yang cocok</p><h2>Untuk tim yang ingin memperbaiki <em>cara kerjanya.</em></h2></div>
            <p>Cocok untuk pemilik bisnis dan pemimpin tim yang punya proses nyata untuk dipelajari bersama, baik pada pekerjaan operasional, administrasi, kreatif, maupun manajemen.</p>
            </div>
          </div>
        </section>
        <section class="section container" id="bentuk-bantuan">
