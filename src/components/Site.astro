    <script>
      function setupAnimatedDropdowns() {
        const detailsList = document.querySelectorAll('details.nav-details, details.mobile-menu');
        detailsList.forEach((details) => {
          if (details.dataset.animReady) return;
          details.dataset.animReady = 'true';

          const summary = details.querySelector('summary');
          const panel = details.querySelector('.nav-details-panel') || details.querySelector('nav');
          if (!summary || !panel) return;

          let isClosing = false;

          function closeSmoothly() {
            if (isClosing || !details.open) return;
            isClosing = true;
            panel.classList.remove('is-opening');
            panel.classList.add('is-closing');

            const onAnimEnd = () => {
              details.removeAttribute('open');
              panel.classList.remove('is-closing');
              panel.removeEventListener('animationend', onAnimEnd);
              isClosing = false;
            };
            panel.addEventListener('animationend', onAnimEnd);
          }

          summary.addEventListener('click', (e) => {
            if (details.open) {
              e.preventDefault();
              closeSmoothly();
            } else {
              panel.classList.remove('is-closing');
              panel.classList.add('is-opening');
            }
          });

          document.addEventListener('click', (e) => {
            if (details.open && !details.contains(e.target)) {
              closeSmoothly();
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && details.open) {
              closeSmoothly();
            }
          });
        });
      }

      setupAnimatedDropdowns();
      document.addEventListener('astro:page-load', setupAnimatedDropdowns);
    </script>
